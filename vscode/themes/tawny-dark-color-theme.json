  "name": "Tawny",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#e2ded5",
    "comment": {
      "foreground": "#9c968b",
      "italic": false
    },
    "enum": "#e2ded5",
    "enumMember": "#e2ded5",
    "function": "#85abd5",
    "interface": "#e2ded5",
    "keyword": {
      "foreground": "#85abd5",
      "italic": false
    },
    "method": "#85abd5",
    "namespace": "#e2ded5",
    "number": "#e2ded5",
    "operator": "#e2ded5",
    "parameter": "#e2ded5",
    "property": "#e2ded5",
    "string": "#abcd7a",
    "struct": "#e2ded5",
    "type": "#e2ded5",
    "typeParameter": "#e2ded5",
    "variable": "#e2ded5",
    "variable.defaultLibrary": "#e2ded5",
    "variable.readonly": "#e2ded5"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#9c968b"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
